{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "lib": ["esnext", "DOM"],
        "moduleResolution": "bundler",
        "declaration": true,
        "strict": true,
        "declarationMap": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "types": ["node"],
        "paths": {
            "@core/*": ["./src/*"],
            "@parsers/*": ["./src/parsers/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
